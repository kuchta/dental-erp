{
	"tasks": {
		"desktop": "deno desktop --allow-env --allow-sys --allow-ffi --allow-read"
	},
	// "nodeModulesLinker": "hoisted",
	"desktop": {
		"app": {
			"name": "DentalERP",
			"icons": {
				"macos": "./public/images/icon-512x512.png",
				"windows": "./public/images/icon-512x512.png",
				"linux": "./public/images/icon-512x512.png"
			}
		},
		// "output": {
		// 	"macos": "DentalERP.dmg",
		// 	"windows": "DentalERP.msi",
		// 	"linux": "DentalERP.AppImage"
		// }
	},
	"allowScripts": [
		"npm:@parcel/watcher@2.6.0",
		"npm:@prisma/client@5.22.0",
		"npm:@prisma/engines@5.22.0",
		"npm:@swc/core@1.15.46",
		"npm:esbuild@0.21.5",
		"npm:esbuild@0.28.1",
		"npm:fsevents@2.3.2",
		"npm:fsevents@2.3.3",
		"npm:prisma@5.22.0",
		"npm:sharp@0.34.5",
		"npm:unrs-resolver@1.12.2"
	],
	"unstable": [
		"detect-cjs",
		"node-globals",
		"unsafe-proto",
		"sloppy-imports"
  	]
}
